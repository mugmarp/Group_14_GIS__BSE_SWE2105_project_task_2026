rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isMemberOfGroup(groupId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isValidGroup(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 60 &&
        data.inviteCode is string && data.inviteCode.size() >= 4 && data.inviteCode.size() <= 12 &&
        data.createdBy is string && data.createdBy.size() > 0 &&
        data.memberIds is list && data.memberIds.size() > 0 && data.memberIds.size() <= 100;
    }

    function isValidMemberLocation(data) {
      return data.userId is string && data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 50 &&
        data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
        data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
        (!('deviceId' in data) || (data.deviceId is string && data.deviceId.size() <= 80)) &&
        (!('deviceModel' in data) || (data.deviceModel is string && data.deviceModel.size() <= 80)) &&
        (!('bleTag' in data) || (data.bleTag is string && data.bleTag.size() <= 16)) &&
        (!('accuracy' in data) || data.accuracy is number) &&
        (!('speed' in data) || data.speed is number) &&
        (!('bearing' in data) || data.bearing is number) &&
        (!('altitude' in data) || data.altitude is number) &&
        (!('batteryPercent' in data) || (data.batteryPercent is int && data.batteryPercent >= 0 && data.batteryPercent <= 100)) &&
        (!('isCharging' in data) || data.isCharging is bool) &&
        (!('isSharingEnabled' in data) || data.isSharingEnabled is bool);
    }

    function isValidPersonalDevice(data) {
      return data.userId is string && data.userId == request.auth.uid &&
        data.deviceId is string && data.deviceId.size() > 0 && data.deviceId.size() <= 80 &&
        data.deviceName is string && data.deviceName.size() > 0 && data.deviceName.size() <= 60 &&
        data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
        data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
        (!('deviceModel' in data) || (data.deviceModel is string && data.deviceModel.size() <= 80)) &&
        (!('bleTag' in data) || (data.bleTag is string && data.bleTag.size() <= 16)) &&
        (!('accuracy' in data) || data.accuracy is number) &&
        (!('speed' in data) || data.speed is number) &&
        (!('bearing' in data) || data.bearing is number) &&
        (!('batteryPercent' in data) || (data.batteryPercent is int && data.batteryPercent >= 0 && data.batteryPercent <= 100)) &&
        (!('isCharging' in data) || data.isCharging is bool) &&
        (!('ringRequestedAt' in data) || data.ringRequestedAt is number) &&
        (!('ringRequestedBy' in data) || (data.ringRequestedBy is string && data.ringRequestedBy.size() <= 60));
    }

    // Personal Multi-Device Fleet & Remote Ring Controls (strictly owned by userId)
    match /users/{userId}/devices/{deviceId} {
      allow read, delete: if isAuthenticated() && request.auth.uid == userId;

      allow create, update: if isAuthenticated() &&
        request.auth.uid == userId &&
        isValidPersonalDevice(request.resource.data);
    }

    // Shared Tracking Groups Collection
    match /groups/{groupId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.uid in request.resource.data.memberIds &&
        isValidGroup(request.resource.data);

      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.createdBy || request.auth.uid in resource.data.memberIds || request.auth.uid in request.resource.data.memberIds) &&
        isValidGroup(request.resource.data);

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.createdBy;

      match /live_locations/{locationDocId} {
        allow read: if isMemberOfGroup(groupId);

        allow create: if isAuthenticated() &&
          isMemberOfGroup(groupId) &&
          request.resource.data.userId == request.auth.uid &&
          isValidMemberLocation(request.resource.data);

        allow update: if isAuthenticated() &&
          isMemberOfGroup(groupId) &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          isValidMemberLocation(request.resource.data);

        allow delete: if isAuthenticated() &&
          (resource.data.userId == request.auth.uid || locationDocId == request.auth.uid);
      }
    }
  }
}
